# Patterns to ignore when building packages.
.git
.gitignore
AGENTS.md
*.swp
*.bak
*.tmp
*.orig
.DS_Store
# IDE and editor artifacts
.idea/
# Previously packaged archives (would otherwise be nested into the new one)
*.tgz
# Trivy scan reports and cache (generated by CI before `helm package .`)
trivy-results*
*.sarif
.cache/
